{
  "name": "oss-browser",
  "version": "1.21.1",
  "main": "dist/main.js",
  "scripts": {
    "test": "ava",
    "dev": "npm-run-all --parallel build watch dev:run",
    "dev:run": "cross-env NODE_ENV=development electron .",
    "dev:run:proxy": "cross-env http_proxy=http://127.0.0.1:9090 https_proxy=http://127.0.0.1:9090 NODE_ENV=development electron .",
    "postbuild": "node gen",
    "prod": "cd dist && cross-env NODE_ENV=production electron .",
    "build": "node build.mjs",
    "build:full": "node build.mjs --dist-install",
    "watch": "node build.mjs --watch",
    "e2e": "playwright test",
    "lint": "eslint --fix \"app/**/*.{js,mjs,vue}\" \"test/**/*.{js,mjs}\"",
    "prepare": "husky",
    "test:renderer": "vitest run",
    "test:all": "npm test && npm run test:renderer"
  },
  "build": {
    "appId": "com.aliyun.oss-browser",
    "productName": "oss-browser",
    "electronLanguages": [
      "zh-CN",
      "en-US",
      "ja-JP"
    ],
    "directories": {
      "app": "dist",
      "output": "build"
    },
    "files": [
      "**/*",
      "!node_modules/**/*.{md,md5,map,ts}",
      "!node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "custom",
        "to": "custom"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}",
      "icon": "custom/icon-256.png"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}",
      "icon": "custom/icon.icns"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "ava": {
    "files": [
      "test/import-config-parser.mjs",
      "test/unit/**/*.test.mjs"
    ],
    "serial": true
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/test-utils": "^2.6.0",
    "ava": "^8.4.0",
    "bootstrap": "^3.4.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.23",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "jquery": "^3.7.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.1",
    "npm-run-all": "^4.0.2",
    "pinia": "^3.0.4",
    "qrcode-generator": "^2.0.4",
    "showdown": "^2.1.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.5"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "aliyun-sdk": "^1.12.10",
    "electron-log": "^5.4.4",
    "koa": "^2.16.4",
    "koa-convert": "^2.0.0",
    "koa-static-server": "^1.5.2",
    "mime": "^4.1.2",
    "nodemailer": "^6.10.1",
    "platform": "^1.3.5"
  },
  "lint-staged": {
    "app/**/*.js": "eslint --fix"
  }
}
