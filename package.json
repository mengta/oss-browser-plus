{
  "name": "oss-browser",
  "version": "1.19.2",
  "main": "dist/main.js",
  "scripts": {
    "test": "ava",
    "dev": "npm-run-all --parallel build watch dev:run",
    "dev:run": "cross-env NODE_ENV=development electron .",
    "dev:run:proxy": "cross-env http_proxy=http://127.0.0.1:9090 https_proxy=http://127.0.0.1:9090 NODE_ENV=development electron .",
    "postbuild": "node gen",
    "prod": "cd dist && cross-env NODE_ENV=production electron .",
    "build": "node build.mjs",
    "build:full": "node build.mjs --dist-install",
    "watch": "node build.mjs --watch",
    "rcedit": "cp tools/rcedit-x64.exe node_modules/rcedit/bin/rcedit.exe",
    "lint": "eslint --fix app"
  },
  "engines": {
    "node": ">=22"
  },
  "ava": {
    "files": [
      "test/import-config-parser.mjs",
      "test/unit/**/*.test.mjs"
    ],
    "serial": true
  },
  "devDependencies": {
    "@alicloud/eslint-config": "^1.2.23",
    "angular": "^1.8.3",
    "angular-bootstrap-contextmenu": "^1.1.0",
    "angular-sanitize": "^1.8.3",
    "angular-ui-bootstrap": "^2.5.6",
    "angular-ui-codemirror": "0.3.0",
    "angular-ui-router": "^0.4.3",
    "ava": "^8.4.0",
    "babel-eslint": "^10.1.0",
    "bootstrap": "^3.4.1",
    "clipboard": "^1.7.1",
    "codemirror": "^5.65.21",
    "commander": "~2.9.0",
    "cross-env": "^3.1.4",
    "electron": "^45.3.2",
    "electron-packager": "7.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.1.0",
    "font-awesome": "^4.7.0",
    "husky": "^4.2.3",
    "jquery": "^3.7.1",
    "jquery.qrcode": "^1.0.3",
    "lint-staged": "^10.1.2",
    "minimist": "^1.2.0",
    "mocha": "~2.4.5",
    "moment": "^2.31.0",
    "npm-run-all": "^4.0.2",
    "should": "~9.0.0",
    "showdown": "^2.1.0",
    "spectron": "^3.7.2"
  },
  "dependencies": {
    "ali-oss": "^6.13.2",
    "aliyun-sdk": "^1.12.3",
    "clipboard": "^1.7.1",
    "electron-log": "1.3.0",
    "emoji-regex": "^9.0.0",
    "koa": "^2.3.0",
    "koa-convert": "^1.2.0",
    "koa-static-server": "^1.2.1",
    "mime": "^1.3.6",
    "nodemailer": "4.0.1",
    "nodemailer-smtp-transport": "2.7.4",
    "platform": "^1.3.5",
    "request": "^2.83.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "app/**/*.js": [
      "eslint --fix",
      "git add"
    ]
  }
}
