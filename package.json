{
  "name": "oss-browser",
  "version": "1.20.2",
  "main": "dist/main.js",
  "scripts": {
    "test": "ava",
    "dev": "npm-run-all --parallel build watch dev:run",
    "dev:run": "cross-env NODE_ENV=development electron .",
    "dev:run:proxy": "cross-env http_proxy=http://127.0.0.1:9090 https_proxy=http://127.0.0.1:9090 NODE_ENV=development electron .",
    "postbuild": "node gen",
    "prod": "cd dist && cross-env NODE_ENV=production electron .",
    "build": "node build.mjs",
    "build:full": "node build.mjs --dist-install",
    "watch": "node build.mjs --watch",
    "e2e": "playwright test",
    "lint": "eslint --fix --ext .js,.mjs app test"
  },
  "build": {
    "appId": "com.aliyun.oss-browser",
    "productName": "oss-browser",
    "directories": {
      "app": "dist",
      "output": "build"
    },
    "files": [
      "**/*",
      "!node_modules/**/*.{md,md5,map,ts}",
      "!node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "custom",
        "to": "custom"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}",
      "icon": "custom/icon-256.png"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}",
      "icon": "custom/icon.icns"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "ava": {
    "files": [
      "test/import-config-parser.mjs",
      "test/unit/**/*.test.mjs"
    ],
    "serial": true
  },
  "devDependencies": {
    "@alicloud/eslint-config": "^1.2.23",
    "@playwright/test": "^1.65.1",
    "angular": "^1.8.3",
    "angular-bootstrap-contextmenu": "^1.1.0",
    "angular-sanitize": "^1.8.3",
    "angular-ui-bootstrap": "^2.5.6",
    "angular-ui-codemirror": "0.3.0",
    "angular-ui-router": "^0.4.3",
    "ava": "^8.4.0",
    "babel-eslint": "^10.1.0",
    "bootstrap": "^3.4.1",
    "clipboard": "^1.7.1",
    "codemirror": "^5.65.21",
    "cross-env": "^3.1.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.1.0",
    "font-awesome": "^4.7.0",
    "husky": "^4.2.3",
    "jquery": "^3.7.1",
    "jquery.qrcode": "^1.0.3",
    "lint-staged": "^10.1.2",
    "moment": "^2.31.0",
    "npm-run-all": "^4.0.2",
    "showdown": "^2.1.0"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "aliyun-sdk": "^1.12.10",

    "electron-log": "^5.4.4",
    "emoji-regex": "^9.0.0",
    "koa": "^2.16.4",
    "koa-convert": "^2.0.0",
    "koa-static-server": "^1.5.2",
    "mime": "^4.1.2",
    "nodemailer": "^6.10.1",
    "platform": "^1.3.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "app/**/*.js": [
      "eslint --fix",
      "git add"
    ]
  }
}
